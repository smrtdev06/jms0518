# ---------- Database (PostgreSQL) ----------
# Either DATABASE_URL or the DB_* values; DATABASE_URL wins when both are set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_management
DB_USER=postgres
DB_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@localhost:5432/job_management
# "true" for hosted databases that require SSL (Neon, Supabase, RDS...)
DATABASE_SSL=false

# ---------- Sign-in ----------
# Secret used to sign login sessions (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string
# The administrator account. `npm run db:init` creates it, and resets its password when this value changes.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# "true" only when a proxy in front of the site sets X-Forwarded-For (always trusted on Vercel). Then one client
# address is also limited to 40 failed sign-ins in 15 minutes; otherwise the limit is per user ID only.
# TRUST_PROXY=false

# ---------- Resume Tailor (AI writing) ----------
# Which AI writes the resume and cover letter: openai or deepseek
LLM_PROVIDER=deepseek
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Hidden thinking before writing: none (default), low, high or max. Thinking is billed as reply tokens.
DEEPSEEK_REASONING_EFFORT=none
# The tailoring prompts (files), or PROMPT_SYSTEM_TEXT / PROMPT_USER_TEXT with the prompts themselves
PROMPT_SYSTEM=./prompts/DEFAULT_PROMPT_SYSTEM.md
PROMPT_USER=./prompts/DEFAULT_PROMPT_USER.md
# Screening-question prompts for the extension. Defaults to these files when unset.
ANSWERS_PROMPT_SYSTEM=./prompts/DEFAULT_ANSWERS_PROMPT_SYSTEM.md
ANSWERS_PROMPT_USER=./prompts/DEFAULT_ANSWERS_PROMPT_USER.md
# How many links of one batch are processed at the same time (1-20)
LINKS_AT_ONCE=5
# Optional: path to Chrome/Edge for job pages that need JavaScript (found automatically on Windows)
# CHROME_PATH=

# ---------- Gmail interview requests (Administrator -> Gmail) ----------
# The OAuth client from the Google Cloud console (APIs & Services -> Clients, type "Web application"). Its
# "Authorized redirect URIs" must list <site>/api/gmail/callback for every address the site runs at
# (e.g. https://your-app.vercel.app/api/gmail/callback and http://localhost:3000/api/gmail/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where Google returns after Connect: a path, put after the address the site is visited at
# (http://localhost:3000/api/gmail/callback locally, https://your-app.vercel.app/api/gmail/callback on Vercel)
GOOGLE_GMAIL_REDIRECT_URI=/api/gmail/callback
# Vercel only: Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/sync (any long random string)
# CRON_SECRET=
# How many days back the first check of a newly connected Gmail reads (1-90, default 14)
# GMAIL_FIRST_SYNC_DAYS=14
# The email-analysis prompt (file), or ANALYZE_EMAIL_PROMPT_TEXT with the prompt itself
# ANALYZE_EMAIL_PROMPT=./prompts/DEFAULT_PROMPT_ANALYZE_EMAIL.md
# "off" stops a long-running server (npm run dev / start:all) from running the daily check itself
# GMAIL_SCHEDULER=on

# ---------- Job links bot ----------
# Key the job-finding bot sends to POST /api/job-links (Authorization: Bearer <key> or X-API-Key: <key>)
JOB_LINKS_API_KEY=change-me-to-a-long-random-key
