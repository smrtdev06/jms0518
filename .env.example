# ---------- Database (PostgreSQL) ----------
# Either DATABASE_URL or the DB_* values; DATABASE_URL wins when both are set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_management
DB_USER=postgres
DB_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@localhost:5432/job_management
# "true" for hosted databases that require SSL (Neon, Supabase, RDS...)
DATABASE_SSL=false

# ---------- Sign-in ----------
# Secret used to sign login sessions (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string
# The administrator account. `npm run db:init` creates it, and resets its password when this value changes.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---------- Resume Tailor (AI writing) ----------
# Which AI writes the resume and cover letter: openai or deepseek
LLM_PROVIDER=deepseek
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Hidden thinking before writing: none (default), low, high or max. Thinking is billed as reply tokens.
DEEPSEEK_REASONING_EFFORT=none
# The tailoring prompts (files), or PROMPT_SYSTEM_TEXT / PROMPT_USER_TEXT with the prompts themselves
PROMPT_SYSTEM=./prompts/DEFAULT_PROMPT_SYSTEM.md
PROMPT_USER=./prompts/DEFAULT_PROMPT_USER.md
# How many links of one batch are processed at the same time (1-20)
LINKS_AT_ONCE=5
# Optional: path to Chrome/Edge for job pages that need JavaScript (found automatically on Windows)
# CHROME_PATH=

# ---------- Job links bot ----------
# Key the job-finding bot sends to POST /api/job-links (Authorization: Bearer <key> or X-API-Key: <key>)
JOB_LINKS_API_KEY=change-me-to-a-long-random-key
